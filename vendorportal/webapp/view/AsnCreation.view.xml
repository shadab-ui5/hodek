            <Toolbar id="_IDGenToolbar3">
                <ToolbarSpacer id="_IDGenToolbarSpacer3"/>
                <Button id="_IDGenButton7" text="Reprint Gate Entry" press="onRePrintGateEntryQR"/>
                <Button id="_IDGenButton8" text="Cancel Gate Entry" press="onCancelGateEntry"/>
