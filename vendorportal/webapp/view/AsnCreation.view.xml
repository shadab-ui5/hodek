<mvc:View controllerName="hodek.vendorportal.controller.AsnCreation"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="asnCreationpage" title="{i18n>title}" showFooter="true" titleAlignment="Auto" showNavButton="true" navButtonPress="onNavBack">
        <Panel id="_IDGenPanel" class="sapUiContentPadding">
            <HBox id="_IDGenHBox1">
                <VBox id="_IDGenVBox" width="25%">
                    <Label id="_IDGenLabel" text="Plant" required="true"/>
                    <!-- <ComboBox id="idDropdownPlant" selectedKey="" width="75%" selectionChange="onSelectPlant">
                        <items>
                            <core:Item key="" text=""/>
                            <core:Item key="1100" text="MACPL Unit 3"/>
                            <core:Item key="2100" text="MACPL Unit 4"/>
                            <core:Item key="2200" text="MACPL Unit 5"/>
                        </items>
                    </ComboBox> -->
                    <!-- <ComboBox id="idDropdownPlant" selectedKey="" width="75%" selectionChange="onSelectPlant" items="{
					    path: '/',
                        sorter: { path: 'Plant' }
                    }">
                        <core:Item id="_IDGenItem" key="{Plant}" text="{Plant} - {PlantName}"/>
                    </ComboBox> -->
                </VBox>
                <VBox id="_IDGenVBox1" width="25%">
                    <Label id="_IDGenLabel1" text="Inward Type" required="true"/>
                    <!-- <ComboBox id="idDropdownInwardType" selectedKey="" width="75%" selectionChange="onSelectInwardType">
                        <core:Item id="_IDGenItem1" key="ReceiptAgainstPO" text="Receipt Against PO"/>
                        <core:Item id="_IDGenItem2" key="ReceiptAsItIs" text="Receipt As It Is"/>
            
                    </ComboBox> -->
                </VBox>
                <VBox id="_IDGenVBox2" width="25%">
                    <Label id="_IDGenLabel2" text="Date"/>
                    <Input id="idRAPO_Date" enabled="true" width="75%"/>
                </VBox>
                <VBox id="_IDGenVBox3" width="25%">
                    <Label id="_IDGenLabel3" text="Time"/>
                    <Input id="idRAPO_Time" enabled="true" width="75%"/>
                </VBox>
            </HBox>
        </Panel>

        <Panel id="idPanelRAPO" class="sapUiContentPadding" headerText="General Data" visible="true">
            <HBox id="_IDGenHBox2">
                <VBox id="_IDGenVBox4" width="25%">
                    <Label id="_IDGenLabel4" text="Purchase Order" required="true"/>
                    <Input id="idRAPO_PO_Order" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="POValueHelp" maxLength="10" width="75%"/>
                </VBox>
                <VBox id="_IDGenVBox5" width="25%">
                    <Label id="_IDGenLabel5" text="Doc./Inv. No" required="true"/>
                    <Input id="idDocInvNo" value="" change="onChangeDocInvNo" maxLength="16" width="75%"/>
                </VBox>
                <VBox id="_IDGenVBox6" width="25%">
                    <Label id="_IDGenLabel6" text="Invoice/DC Date" required="true"/>
                    <DatePicker id="idRAPO_InvDate" width="75%" placeholder="Select Date" displayFormat="MMM dd, yyyy" enabled="true" class="sapUiSmallMarginBottom"/>
                </VBox>
                <VBox id="_IDGenVBox7" width="25%">
                    <Label id="_IDGenLabel7" text="Vehical Number" required="true"/>
                    <Input id="idRAPO_VehicalNo" maxLength="10" width="75%"/>
                </VBox>
                <VBox id="_IDGenVBox8" width="25%">
                    <Label id="_IDGenLabel8" text="Transporter" required="true"/>
                    <Input id="idRAPO_Trasporter" showValueHelp="true" valueHelpRequest="transporterValueHelp" maxLength="50" width="75%"/>
                </VBox>
            </HBox>

            <HBox id="_IDGenHBox3" class="sapUiTinyMarginTop">
                <VBox id="_IDGenVBox9" width="25%">
                    <Label id="_IDGenLabel9" text="Amount" required="true"/>
                    <Input id="idRAPO_Amount" change="onChangeRAPOAmount" type="Number" width="75%"/>
                </VBox>
                <VBox id="_IDGenVBox10" width="25%">
                    <Label id="_IDGenLabel10" text="Eway Bill Number" required="true"/>
                    <Input id="idRAPO_EwayNo" maxLength="50" width="75%"/>
                </VBox>
                <VBox id="_IDGenVBox11" width="25%">
                    <Label id="_IDGenLabel11" text="LR Date"/>
                    <DatePicker id="idRAPO_LR_Date" width="75%" placeholder="Select Date" change="handleChange_RAPO_LRDate" displayFormat="MMM dd, yyyy" enabled="true" class="sapUiSmallMarginBottom"/>
                </VBox>
                <VBox id="_IDGenVBox12" width="25%">
                    <Label id="_IDGenLabel12" text="LR Number"/>
                    <Input id="idRAPO_LR_No" maxLength="25" width="75%"/>
                </VBox>
                <VBox id="_IDGenVBox13" width="25%">
                    <Label id="_IDGenLabel13" text="Fiscal Year"/>
                    <Input id="idFiscalYear" value="" enabled="false" width="75%"/>
                </VBox>
            </HBox>

            <VBox id="_IDGenVBox14" class="sapUiMediumMarginTop">
                <Toolbar id="_IDGenToolbar">
                    <Title id="_IDGenTitle" text="Item Data"/>
                </Toolbar>
                <Table id="idTableAsnItems" alternateRowColors="true" items="{path: 'AsnItemsModel>/Results'}" multiSelectMode="SelectAll" mode="MultiSelect" sticky="ColumnHeaders,HeaderToolbar">
                    <headerToolbar>
                        <OverflowToolbar id="_IDGenOverflowToolbar">
                            <ToolbarSpacer id="_IDGenToolbarSpacer"/>
                            <Button id="_IDGenButton" icon="sap-icon://add" text="Add" press="onAddReceiptAsPOTableItem"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column id="_IDGenColumn">
                            <Text id="_IDGenText" text="PO No. / SA No." />
                        </Column>
                        <Column id="_IDGenColumn1">
                            <Text id="_IDGenText1" text="Line Item No" />
                        </Column>
                        <Column id="_IDGenColumn3">
                            <Text id="_IDGenText3" text="Item Code/Material" />
                        </Column>
                        <Column id="_IDGenColumn4">
                            <Text id="_IDGenText4" text="Item Description" />
                        </Column>
                        <Column id="_IDGenColumn5">
                            <Text id="_IDGenText5" text="UOM" />
                        </Column>
                        <Column id="_IDGenColumn7">
                            <Text id="_IDGenText11" text="Quantity" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem id="_IDGenColumnListItem">
                            <cells>
                                <Text id="_IDGenText18" text="{AsnItemsModel>PurchaseOrder}" />
                                <Text id="_IDGenText15" text="{AsnItemsModel>PurchaseOrderItem}"/>
                                <Text id="_IDGenText16" text="{AsnItemsModel>Material}"/>
                                <Text id="_IDGenText17" text="{AsnItemsModel>PurchaseOrderItemText}"/>
                                <!-- <Input id="_IDGenInput" value="{Material}" showValueHelp="true" valueHelpOnly="true" valueHelpRequest="material_RAPOValueHelp"/> -->                               
                                <Text id="_" text="{AsnItemsModel>BaseUnit}" />
                                <Input id="idInpRAPOItemQuantity" value="{EnteredQuantity}" change="onChangeRAPOItemQuantity" type="Number"  />

                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>

        </Panel>

