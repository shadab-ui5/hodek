<mvc:View controllerName="hodek.vendorportal.controller.PurchaseOrder"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:svm="sap.ui.comp.smartvariants">
    <Page id="purchaseOrderpage" title="Vendor Portal" showFooter="true" titleAlignment="Auto" showNavButton="true" navButtonPress="onNavBack">
        <f:DynamicPage id="_IDGenDynamicPage2" headerExpanded="{/headerExpanded}">
            <f:title>
                <f:DynamicPageTitle id="_IDGenDynamicPageTitle1">
                    <f:navigationActions>
                        <Button text="Next" type="Success" icon="sap-icon://open-command-field" press="onNavNext"/>
                    </f:navigationActions>
                    <f:heading>
                        <Title id="_IDGenTitle4" text="{RoutePoData>/PoHeader/PurchaseOrder}" level="H1"/>
                    </f:heading>
                    <f:expandedContent>
                        <!-- <HBox alignContent="Center" width="100%">
                        <Button text="Back" icon="sap-icon://nav-back" press="onNavBack"/>
                    </HBox> -->
                    </f:expandedContent>
                    <f:snappedContent>
                        <!-- <HBox alignContent="Center" width="100%">
                        <Button text="Back" icon="sap-icon://nav-back" press="onNavBack"/>
                    </HBox> -->
                    </f:snappedContent>
                </f:DynamicPageTitle>
            </f:title>
            <f:header>
                <f:DynamicPageHeader id="_IDGenDynamicPageHeader1">
                    <f:content>
                        <HBox Vd="_IDGenHBox" alignItems="Center" justifyContent="Start">
                            <VBox alignItems="Start" alignContent="Center" justifyContent="Start" class="sapUiContentPadding">
                                <Label class="labelDesin" design="Bold" text="Plant" />
                                <!-- <Text id="idPoHeadPlant" class="sapUiTinyMarginBegin" text="{RoutePoData>/PoHeader/PlantName}"/> -->
                                <Text class="textDesin" text="{RoutePoData>/PoHeader/Plant}" />
                            </VBox>
                            <VBox alignItems="Start" alignContent="Center" justifyContent="Start" class="sapUiContentPadding">
                                <Label class="labelDesin" design="Bold" text="Purchase Order" />
                                <!-- <Text id="idPoHeadPO" class="sapUiTinyMarginBegin" text="{RoutePoData>/PoHeader/PurchaseOrder}"/> -->
                                <Text class="textDesin" text="{RoutePoData>/PoHeader/PurchaseOrder}" />
                            </VBox>
                            <VBox alignItems="Start" alignContent="Center" justifyContent="Start" class="sapUiContentPadding">
                                <Label class="labelDesin" design="Bold" text="Supplier" />
                                <!-- <Text id="idPoHeadSupplier" class="sapUiTinyMarginBegin" text="{RoutePoData>/PoHeader/Supplier}"/> -->
                                <Text class="textDesin" text="{RoutePoData>/PoHeader/Supplier}" />
                            </VBox>
                            <VBox alignItems="Start" alignContent="Center" justifyContent="Start" class="sapUiContentPadding">
                                <Label class="labelDesin" design="Bold" text="Purchase Order Date" />
                                <!-- <Text id="idPoHeadOrderDate" class="sapUiTinyMarginBegin" text="{path: 'RoutePoData>/PoHeader/PurchaseOrderDate',formatter: '.formatter.formatDateToDDMMYYYY'}"/> -->
                                <Text class="textDesin" text="{path: 'RoutePoData>/PoHeader/PurchaseOrderDate',formatter: '.formatter.formatDateToDDMMYYYY'}"/>
                            </VBox>
                            <VBox alignItems="Start" alignContent="Center" justifyContent="Start" class="sapUiContentPadding">
                                <Label class="labelDesin" design="Bold" text="Sales Person" />
                                <!-- <Text id="idPoHeadSalesPerson" class="sapUiTinyMarginBegin" text="{RoutePoData>/PoHeader/SupplierRespSalesPersonName}"/> -->
                                <Text class="textDesin" text="{RoutePoData>/PoHeader/SupplierRespSalesPersonName}"/>
                            </VBox>

                        </HBox>
                    </f:content>
                </f:DynamicPageHeader>
            </f:header>
            <f:content>
                <Table id="idPoItemTable" alternateRowColors="true" mode="MultiSelect" multiSelectMode="SelectAll" growing="true" growingScrollToLoad="true" growingThreshold="20" updateStarted="onUpdateStartPoHeaderTable" items="{PoItemModel>/POItems}" itemPress="onLineItemPress" sticky="ColumnHeaders,HeaderToolbar">
                    <headerToolbar>
                        <OverflowToolbar id="_IDGenOverflowToolbar">
                            <Title id="_IDGenTitle6" text="Items" level="H2"/>
                            <ToolbarSpacer id="_IDGenToolbarSpacer1"/>
                            <Button id="_IDGenButton3" tooltip="Sort" icon="sap-icon://sort" press="handleSortButtonPressed"/>
                            <Button id="_IDGenButton5" tooltip="Filter" icon="sap-icon://filter" press="handleFilterButtonPressed"/>
                            <Button id="_IDGenButton6" tooltip="Group" icon="sap-icon://group-2" press="handleGroupButtonPressed"/>
                            <ToggleButton id="_IDGenToggleButton1" icon="sap-icon://menu" tooltip="Enable Custom Context Menu" press="onToggleContextMenu" />
                        </OverflowToolbar>
                    </headerToolbar>
                    <infoToolbar>
                        <OverflowToolbar id="_IDGenOverflowToolbar2" visible="false">
                            <Text id="_IDGenText14" />
                        </OverflowToolbar>
                    </infoToolbar>
                    <columns>
                        <Column visible="false">
                            <Text text="Purchase Order" />
                        </Column>
                        <Column>
                            <Text text="Item" />
                        </Column>
                        <Column>
                            <Text text="Plant" />
                        </Column>
                        <Column>
                            <Text text="Material" />
                        </Column>
                        <Column>
                            <Text text="Delivery Date" />
                        </Column>
                        <Column>
                            <Text text="Scheduled Qty" />
                        </Column>
                        <Column>
                            <Text text="Delivered Qty" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem >
                            <cells>
                                <Text text="{PoItemModel>PurchaseOrder}" />
                                <Text text="{PoItemModel>PurchaseOrderItem}" />
                                <Text text="{PoItemModel>Plant}" />
                                <Text text="{PoItemModel>ItemDescription}({PoItemModel>Material})" />
                                <Text text="{path: 'PoItemModel>DeliveryDate', formatter: '.formatter.formatDateToDDMMYYYY'}" />
                                <Text text="{PoItemModel>ScheduleQty} {PoItemModel>PurchaseOrderQuantityUnit}" />
                                <Text text="{PoItemModel>DeliveredQty} {PoItemModel>PurchaseOrderQuantityUnit}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </f:content>
        </f:DynamicPage>
    </Page>
</mvc:View>