<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
   <TableSelectDialog
        id="poSelectDialog"
        title="Select Purchase Order"
        growing="true"
        growingThreshold="20"
        multiSelect="true"
        items="{SaModelVh>/PurchaseOrders}"
        confirm=".onPurchaseOrderConfirm"
        cancel=".onPurchaseOrderCancel"
        search=".onPurchaseOrderSearch"
        updateStarted=".onPurchaseOrderUpdateStarted" class="sapUiResponsiveContentPadding">
        
        <columns>
            <Column width="15%"><Text text="SA No"/></Column>
            <Column width="30%"><Text text="Supplier"/></Column>
            <!-- <Column><Text text="Purchasing Group"/></Column> -->
            <Column><Text text="Payment Terms"/></Column>
            <Column><Text text="Plant"/></Column>
        </columns>

        <items>
            <ColumnListItem>
                <cells>
                    <Text text="{parts:[{path:'SaModelVh>SchedulingAgreement'},{path:'SaModelVh>SchedulingAgreement'}],formatter:'.formatter.formatPurchaseOrderText'}" />
                    <Text text="{SaModelVh>SupplierName} ( {SaModelVh>Supplier} )" />
                    <!-- <Text text="{SaModelVh>PurchasingGroup}" /> -->
                    <Text text="{SaModelVh>PaymentTerms}" />
                    <Text text="{SaModelVh>Plant}" />
                </cells>
            </ColumnListItem>
        </items>
    </TableSelectDialog> 

</core:FragmentDefinition>
